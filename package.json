{
  "name": "japan-cultural-properties-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "wrangler types --env-interface CloudflareBindings",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --minify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply japan-cultural-properties-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply japan-cultural-properties-db --remote",
    "db:studio": "drizzle-kit studio",
    "crawl:fetch": "tsx scripts/crawl/fetch-details.ts",
    "crawl:parse": "tsx scripts/crawl/parse-details.ts",
    "crawl:verify": "tsx scripts/crawl/verify.ts",
    "etl:build": "tsx scripts/etl/build-seed.ts",
    "etl:apply": "tsx scripts/etl/apply-seed.ts",
    "openapi:generate": "tsx scripts/openapi/generate.ts",
    "openapi:check": "tsx scripts/openapi/generate.ts --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm test && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@hono/swagger-ui": "^0.6.1",
    "@scalar/hono-api-reference": "^0.11.12",
    "@valibot/to-json-schema": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "hono-openapi": "^1.3.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.4.0",
    "csv-parse": "^7.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
